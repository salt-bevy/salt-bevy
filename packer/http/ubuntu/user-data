#cloud-config
# salt-bevy copy of bento's packer_templates/http/ubuntu/user-data, used only for
# Hyper-V builds (packer/build_boxes.py passes -var http_directory=...). Kept
# identical apart from the late-commands marked "salt-bevy change" below.
autoinstall:
  version: 1
  identity:
    hostname: vagrant
    username: vagrant
    password: '$6$rounds=4096$5CU3LEj/MQvbkfPb$LmKEF9pCfU8R.dA.GemgE/8GT6r9blge3grJvdsVTMFKyLEQwzEF3SGWqAzjawY/XHRpWj4fOiLBrRyxJhIRJ1'
  storage:
    layout:
      name: lvm
      sizing-policy: all
  early-commands:
    # otherwise packer tries to connect and exceed max attempts:
    - systemctl stop ssh.service
    - systemctl stop ssh.socket
  ssh:
    install-server: yes
    allow-pw: yes
  late-commands:
    # salt-bevy change: bento only edits 00-installer-config.yaml, but 24.04+
    # writes 50-cloud-init.yaml, so the MAC client-id was never set there and the
    # VM could come back from the post-update reboot on a different DHCP address
    # (Packer then times out dialing the old one). Edit every netplan file and
    # keep the matched indentation.
    - |
      for f in /target/etc/netplan/*.yaml; do
        [ -f "$f" ] || continue
        grep -q "dhcp-identifier" "$f" || sed -i -E "s/^( *)dhcp4: true/&\n\1dhcp-identifier: mac/" "$f"
      done
    - echo 'vagrant ALL=(ALL) NOPASSWD:ALL' > /target/etc/sudoers.d/vagrant
    # salt-bevy change (bento's version installs these into the installer's live
    # environment, not /target, and uses Debian's "hyperv-daemons" name). Packer
    # finds a Hyper-V VM's IP through the KVP integration service, so the
    # installed system must run hv-kvp-daemon (linux-cloud-tools) or Packer
    # waits for SSH until it times out. Installed only when the box is built
    # on Hyper-V. The services start themselves (ConditionVirtualization=microsoft).
    - |
      if grep -qi "microsoft" /sys/class/dmi/id/sys_vendor 2>/dev/null; then
        curtin in-target --target=/target -- apt-get update
        curtin in-target --target=/target -- apt-get install -y linux-cloud-tools-generic linux-tools-generic cifs-utils
      fi
